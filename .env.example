# URL pública del sitio (se usa en SEO, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.tudominio.com

# Calendly: enlace del evento para agendar citas (ej. https://calendly.com/rochy/visita-oasis)
NEXT_PUBLIC_CALENDLY_URL=

# Supabase: guarda los mensajes del formulario en la tabla `contactos` (crear con supabase/schema.sql)
# Project Settings → API. Usa SOLO la clave pública (anon/publishable), nunca la service_role.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Envío del formulario de contacto por correo con Resend (https://resend.com)
# Si RESEND_API_KEY está vacío, los mensajes solo se registran en los logs del servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Oasis Web <onboarding@resend.dev>
